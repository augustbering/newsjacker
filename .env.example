# Kopiera till .env och fyll i dina värden

# Gemini
GEMINI_API_KEY=din-gemini-api-nyckel-här
GEMINI_MODEL=gemini-3-flash-preview

# Mattermost incoming webhook
MATTERMOST_WEBHOOK_URL=https://chat.piratpartiet.se/hooks/din-webhook-id-här

# E-post (SMTP) – ej längre primär kanal, kan lämnas tomt
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=din@gmail.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# EMAIL_FROM=din@gmail.com
# EMAIL_TO=mottagare@example.com

# Nitter-instans (välj en aktiv publik instans)
NITTER_INSTANCE=https://nitter.net

# Relevanspoäng 0-10, nyheter >= detta skickas med i digest
RELEVANCE_THRESHOLD=6

# Hur ofta agenten körs (timmar)
SCHEDULE_HOURS=2

# Valfritt: kommaseparerade extra e-postmottagare
# EMAIL_CC=cc1@example.com,cc2@example.com
